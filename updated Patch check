let WhichMonth = "July 2026 Security Updates";
let WhichOrg = "TBC";
let MissingUpdate = DeviceTvmSoftwareVulnerabilities 
| where OSPlatform in ("Windows11") 
//| "Windows11"
| where RecommendedSecurityUpdate in (WhichMonth) 
| distinct DeviceName, RecommendedSecurityUpdate; 
DeviceInfo 
| where MachineGroup in (WhichOrg) 
| where OSPlatform in ("Windows11") 
| where ClientVersion != "1.0" 
| summarize arg_max(Timestamp, *) by DeviceName 
| project Timestamp, MachineGroup, DeviceId, DeviceName, ClientVersion, OSArchitecture, OSPlatform, OSBuild, OSVersion, OSVersionInfo, PublicIP, JoinType, LoggedOnUsers 
| join kind=leftouter ( 
    MissingUpdate 
) on DeviceName 
| extend PatchCompliance = iif(OSVersionInfo in ("6.1","6.3") or (OSPlatform == "Windows11"and OSVersionInfo in ("21H2","22H2","23H2")), "End of Support", iif(RecommendedSecurityUpdate in (WhichMonth), "Non-compliant", "Compliant") )
//| extend PatchCompliance = iif(OSVersionInfo in ("6.1","6.3") or (OSPlatform == "Windows10"), "End of Support", iif(RecommendedSecurityUpdate in (WhichMonth), "Non-compliant", "Compliant") )
| summarize Devices=count() by PatchCompliance 
| render piechart 
